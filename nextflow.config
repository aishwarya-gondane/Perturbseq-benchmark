manifest {
    name        = 'perturbseq-benchmark'
    description = 'Guide assignment and perturbation-effect benchmark on Replogle 2022 and Norman 2019'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.10'
}

process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    withName: 'DOWNLOAD|PREPARE'  { memory = '32 GB' }
    withName: 'EFFECTS'           { memory = '8 GB'  }
    withName: 'MIXSCAPE'          { memory = '24 GB' }
    withName: 'MODEL'             { cpus = 2 }
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled   = true
        process.conda   = "${projectDir}/environment.yml"
    }

    // Small run to check that the workflow wires together end to end.
    test {
        params.quick    = true
        params.n_chunks = 2
        process.memory  = '4 GB'
    }

    slurm {
        process.executor = 'slurm'
    }
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
